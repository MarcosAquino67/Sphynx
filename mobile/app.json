{
  "expo": {
    "name": "Sphynx",
    "slug": "sphynx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/SPHYNX_png.png",
    "scheme": "sphynx",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/SPHYNX_png.png",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/SPHYNX_png.png",
        "backgroundImage": "./assets/SPHYNX_png.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sphynx.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/SPHYNX_png.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/SPHYNX_png.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e46e744-de5f-4796-a5e7-b82cd1fc4ff0"
      }
    }
  }
}

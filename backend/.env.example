# Copiá este archivo como ".env" (sin extensión) y pegá tu key.
# Este .example SÍ se sube a git; el ".env" real NO (está en .gitignore).

# Gemini gratis SIN tarjeta (recomendado): https://aistudio.google.com
GEMINI_API_KEY=tu_key_de_google_aqui

# O OpenCode Zen (pide datos de facturación): https://opencode.ai
# OPENCODE_API_KEY=oc_sk_...

# Opcional: forzar proveedor (auto = primera key que encuentre)
# IA_PROVIDER=gemini
# Opcional: forzar modelo
# IA_MODEL=gemini-2.5-flash
